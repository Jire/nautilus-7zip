[Desktop Entry]
Type=Application
Name=7-Zip for Files
GenericName=Archive Manager
Comment=Open, extract, test, compress and checksum archives with 7-Zip
Icon=io.github.jire.Nautilus7Zip
Exec=@HELPER@ %F
TryExec=@HELPER@
Terminal=false
StartupNotify=true
DBusActivatable=true
Categories=GTK;GNOME;Utility;Archiving;Compression;
Keywords=7z;7-Zip;7zip;zip;rar;tar;archive;compress;extract;unzip;unpack;checksum;sha256;
MimeType=application/x-7z-compressed;application/zip;application/x-zip;application/x-zip-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-tar;application/x-gtar;application/x-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lzma-compressed-tar;application/x-tarz;application/gzip;application/x-gzip;application/x-bzip2;application/x-xz;application/zstd;application/x-lzma;application/x-compress;application/x-cpio;application/vnd.ms-cab-compressed;application/x-arj;application/x-lha;application/x-lzh-compressed;application/x-ms-wim;application/x-xar;application/x-iso9660-image;application/x-cd-image;application/x-apple-diskimage;application/x-rpm;application/vnd.debian.binary-package;application/vnd.comicbook+zip;application/vnd.comicbook-rar;application/x-cb7;
